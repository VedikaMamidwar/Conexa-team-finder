    const location = useLocation();

    const message =
        location.state?.message ||
        "Your stakeholder application has been submitted. You can sign in after an administrator approves your account.";

    return (
        <div className="flex min-h-screen items-center justify-center bg-[#F8FAFC] px-4">
            <div className="w-full max-w-md rounded-2xl border border-amber-200 bg-white p-8 text-center shadow-xl">
                <div className="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-amber-100 text-amber-700">
                    <span className="text-3xl">⏳</span>
                </div>

                <h1 className="text-2xl font-black text-[#1E1B4B]">
                    Application Pending
                </h1>

                <p className="mt-3 text-sm leading-6 text-slate-600">
                    {message}
                </p>

                <p className="mt-3 text-sm leading-6 text-slate-500">
                    Our admin team will review your organization.
                    You can access your stakeholder dashboard after approval.
                </p>

                <Link
                    to="/login"
                    className="mt-6 inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-[#1E1B4B] px-6 text-sm font-bold text-white transition hover:bg-[#312E81]"
                >
                    Go to Sign In
                    <ArrowRight size={16} />
                </Link>

                <Link
                    to="/landing"
                    className="mt-4 block text-sm font-semibold text-slate-500 hover:text-[#14B8A6]"
                >
                    Back to Home
                </Link>
            </div>
        </div>
    );
}

